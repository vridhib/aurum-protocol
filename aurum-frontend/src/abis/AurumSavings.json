                        "details": "Yield is automatically accrued before minting. Shares are calculated based on the current `accruedPerShare`.",
                        "params": {
                            "amount": "The amount of AUSD to deposit. Must be greater than zero."
                        }
                    },
                    "getAccruedPerShare()": {
                        "details": "To compute the value of a user's deposit: `(shares * accruedPerShare) / 1e18`."
                    },
                    "setSavingsRate(uint256)": {
                        "details": "Can only be called by the treasury address. The new rate must be no more than 20% (0.20e18).",
                        "params": {
                            "newRate": "The new savings rate, scaled by 1e18."
                        }
                    },
                    "withdraw(uint256)": {
                        "details": "Yield is automatically accrued before withdrawal. The user receives principal + accumulated yield.",
                        "params": {
                            "shares": "The number of shares to burn. Must be less than or equal to the caller’s share balance."
                        }
                    }
                },
